@model AdminDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
    var id = AdminViewHelpers.GetRawValue(Model.Entity, "Id");
}

<section class="page-header">
    <div>
        <span class="eyebrow">Detalhes</span>
        <h1>@Model.Title</h1>
    </div>
    <div class="header-actions">
        <a class="button button-secondary" asp-controller="@Model.ControllerName" asp-action="Edit" asp-route-id="@id">
            <i class="fa-solid fa-pen"></i>
            <span>Editar</span>
        </a>
    </div>
</section>

<section class="panel details-panel">
    <dl class="details-grid">
        @foreach (var field in Model.Fields)
        {
            var value = AdminViewHelpers.GetDisplayValue(Model.Entity, field.PropertyPath, field.Format);
            <div>
                <dt>@field.Label</dt>
                <dd>
                    @if (field.Format == AdminDisplayFormat.Status)
                    {
                        <span class="@AdminViewHelpers.GetBadgeClass(value)">@value</span>
                    }
                    else
                    {
                        @value
                    }
                </dd>
            </div>
        }
    </dl>
    <div class="form-actions">
        <a class="button button-ghost" asp-controller="@Model.ControllerName" asp-action="Index">Voltar</a>
    </div>
</section>
