@using ScholarWeb.Models
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    string NavClass(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "nav-link active" : "nav-link";
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ScholarWeb</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
</head>
<body class="@(isAuthenticated ? "admin-body" : "auth-body")">
    @if (isAuthenticated)
    {
        <div class="app-shell">
            <aside class="sidebar" id="sidebar">
                <a class="brand" asp-controller="Dashboard" asp-action="Index">
                    <span class="brand-mark"><i class="fa-solid fa-graduation-cap"></i></span>
                    <span>ScholarWeb</span>
                </a>

                <nav class="sidebar-nav" aria-label="Menu principal">
                    <a class="@NavClass("Dashboard")" asp-controller="Dashboard" asp-action="Index"><i class="fa-solid fa-gauge-high"></i><span>Dashboard</span></a>
                    <a class="@NavClass("Alunos")" asp-controller="Alunos" asp-action="Index"><i class="fa-solid fa-user-graduate"></i><span>Alunos</span></a>
                    <a class="@NavClass("Professores")" asp-controller="Professores" asp-action="Index"><i class="fa-solid fa-chalkboard-user"></i><span>Professores</span></a>
                    <a class="@NavClass("Cursos")" asp-controller="Cursos" asp-action="Index"><i class="fa-solid fa-book-open"></i><span>Cursos</span></a>
                    <a class="@NavClass("Turmas")" asp-controller="Turmas" asp-action="Index"><i class="fa-solid fa-users-rectangle"></i><span>Turmas</span></a>
                    <a class="@NavClass("Disciplinas")" asp-controller="Disciplinas" asp-action="Index"><i class="fa-solid fa-book"></i><span>Disciplinas</span></a>
                    <a class="@NavClass("Matriculas")" asp-controller="Matriculas" asp-action="Index"><i class="fa-solid fa-clipboard-list"></i><span>Matriculas</span></a>
                    <a class="@NavClass("Notas")" asp-controller="Notas" asp-action="Index"><i class="fa-solid fa-star-half-stroke"></i><span>Notas</span></a>
                    <a class="@NavClass("Financeiro")" asp-controller="Financeiro" asp-action="Index"><i class="fa-solid fa-file-invoice-dollar"></i><span>Financeiro</span></a>
                    <a class="@NavClass("PeriodosLetivos")" asp-controller="PeriodosLetivos" asp-action="Index"><i class="fa-solid fa-calendar-days"></i><span>Periodos</span></a>
                </nav>
            </aside>

            <div class="app-content">
                <header class="topbar">
                    <button class="icon-button" type="button" id="sidebarToggle" aria-label="Alternar menu" aria-controls="sidebar" aria-expanded="false">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div class="topbar-title">
                        <span>Painel administrativo</span>
                        <strong>@(ViewData["Title"] ?? "ScholarWeb")</strong>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                        <button type="submit" class="button button-ghost"><i class="fa-solid fa-right-from-bracket"></i><span>Sair</span></button>
                    </form>
                </header>

                <main class="content" role="main">
                    @if (TempData["Success"] is string success)
                    {
                        <div class="alert alert-success"><i class="fa-solid fa-circle-check"></i><span>@success</span></div>
                    }
                    @if (TempData["Error"] is string error)
                    {
                        <div class="alert alert-danger"><i class="fa-solid fa-triangle-exclamation"></i><span>@error</span></div>
                    }
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <main class="auth-wrapper" role="main">
            @RenderBody()
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
